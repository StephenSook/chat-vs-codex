# Public Twitch application Client ID. No client secret is required.
TWITCH_CLIENT_ID=

# Optional neural commentary. Uses the standard AWS credential provider chain.
POLLY_ENABLED=0

# Optional 60-second live title score. Restores the exact original title.
TITLE_SCOREBUG=0

# Optional boss cadence; 0 disables automatic every-Nth-round scheduling.
BOSS_EVERY=0

# Experimental telemetry classifier; uncalibrated, off by default.
TRIAGE_ENABLED=0
# Add the enum model hypothesis to runtime repair tickets only when enabled.
TRIAGE_HINT=0

# Optional Twitch Extension PubSub bridge. Extension credentials differ from the chat app.
# Supply the base64 shared secret from the host credential store; never VITE_* or a browser bundle.
EXTENSION_ENABLED=0
TWITCH_EXTENSION_CLIENT_ID=
# Public Twitch user ID of the Extension owner, which may differ from the broadcaster.
TWITCH_EXTENSION_OWNER_ID=
TWITCH_EXTENSION_SECRET=
