# Public Twitch application Client ID. No client secret is required.
TWITCH_CLIENT_ID=

# Optional neural commentary. Uses the standard AWS credential provider chain.
POLLY_ENABLED=0

# Optional 60-second live title score. Restores the exact original title.
TITLE_SCOREBUG=0

# Optional boss cadence; 0 disables automatic every-Nth-round scheduling.
BOSS_EVERY=0

# Experimental telemetry classifier; uncalibrated, off by default.
TRIAGE_ENABLED=0
# Add the enum model hypothesis to runtime repair tickets only when enabled.
TRIAGE_HINT=0
