{
  "expo": {
    "name": "Pit Wall",
    "slug": "chat-vs-codex-pit-wall",
    "owner": "stephensook",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pit-wall",
    "ios": {
      "bundleIdentifier": "com.stephensookra.chatvscodex.pitwall",
      "buildNumber": "3",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to the round runner on your Mac.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "com.stephensookra.chatvscodex.pitwall",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f1d1b"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "b102f054-9fdd-429e-8750-f6a0e446186b",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "PitWallLiveWidget",
                  "bundleIdentifier": "com.stephensookra.chatvscodex.pitwall.PitWallLiveWidget",
                  "entitlements": {}
                }
              ]
            }
          }
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      ["expo-notifications", { "enableRemoteNotifications": false }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1f1d1b"
        }
      ],
      "./plugins/withPitWallLive.cjs"
    ]
  }
}
