{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["react", "node"]
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "test/**/*.ts"]
}
