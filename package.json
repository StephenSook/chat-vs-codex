{
  "name": "chat-vs-codex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "replay:record": "tsx packages/replay/src/record.ts",
    "replay:check": "tsx packages/replay/src/record.ts --check",
    "mutator:pool": "tsx packages/mutator/src/cli.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:canary": "tsx scripts/bench-canary.ts",
    "bench:summary": "tsx scripts/bench.ts --summary",
    "ci:local": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@openai/codex-sdk": "0.163.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
