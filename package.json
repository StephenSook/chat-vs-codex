{
  "name": "chat-vs-codex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm season:check && vitest run",
    "replay:record": "tsx packages/replay/src/record.ts",
    "replay:check": "tsx packages/replay/src/record.ts --check",
    "mutator:pool": "tsx packages/mutator/src/cli.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:canary": "tsx scripts/bench-canary.ts",
    "bench:summary": "tsx scripts/bench.ts --summary",
    "round:fixture": "pnpm --filter @chat-vs-codex/round fixture",
    "round:live": "pnpm --filter @chat-vs-codex/round live",
    "obs:scene": "tsx scripts/obs-scene.ts",
    "judge:build": "pnpm --filter @chat-vs-codex/judge build",
    "judge:preview": "pnpm --filter @chat-vs-codex/judge preview",
    "judge:smoke": "pnpm --filter @chat-vs-codex/judge smoke",
    "hotfix:ready": "tsx .agents/skills/hotfix-ready/scripts/prepare.ts",
    "breakout:dev": "pnpm --filter @chat-vs-codex/breakout dev",
    "breakout:build": "pnpm --filter @chat-vs-codex/breakout build",
    "breakout:pool": "tsx packages/hotfix-ready/src/cli.ts gate games/breakout",
    "breakout:bench": "tsx games/breakout/bench.ts",
    "sound:generate": "tsx scripts/sound-synth.ts",
    "chat-found:pr": "tsx scripts/chat-found-pr.ts",
    "pit-wall:icons": "tsx scripts/pit-wall-icons.ts",
    "pit-wall:bundle": "pnpm --filter @chat-vs-codex/pit-wall-app exec expo export --platform ios --output-dir dist/ios && pnpm --filter @chat-vs-codex/pit-wall-app exec expo export --platform android --output-dir dist/android",
    "ci:local": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm test && pnpm pit-wall:bundle",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "season:record": "tsx scripts/season.ts",
    "season:check": "tsx scripts/season.ts --check",
    "triage:setup": "tsx scripts/triage.ts --setup",
    "triage:record": "tsx scripts/triage.ts --record",
    "triage:check": "tsx scripts/triage.ts --check",
    "triage:ab": "tsx scripts/triage-ab.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@openai/codex-sdk": "0.163.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
